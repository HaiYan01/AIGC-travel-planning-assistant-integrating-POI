/* 全局样式 - 苹果液态玻璃 8%微磨砂 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: white;
  min-height: 100vh;
}

/* 背景图片层 */
.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

/* 页面容器 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  position: relative;
  z-index: 1;
  padding: 30rpx;
  min-height: 100vh;
}

/* 苹果液态玻璃卡片 - 8%微磨砂 */
.glass-card {
  position: relative;
  padding: 32rpx;
  border-radius: 28rpx;
  background: transparent;
  
  /* 8% 微磨玻璃 */
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  
  /* 高亮边缘 */
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  
  color: white;
  overflow: hidden;
  margin-bottom: 24rpx;
}

/* 玻璃折射光层 */
.glass-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.18) 0%, 
    rgba(255, 255, 255, 0.08) 50%,
    rgba(255, 255, 255, 0.12) 100%);
  pointer-events: none;
  mix-blend-mode: screen;
  border-radius: 28rpx;
}

/* 苹果液态玻璃按钮 */
.glass-btn {
  position: relative;
  padding: 24rpx 40rpx;
  border-radius: 20rpx;
  background: transparent;
  
  /* 8% 微磨玻璃 */
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  
  /* 高亮边缘 */
  border: 1px solid rgba(255, 255, 255, 0.55);
  box-shadow: 
    0 4rpx 16rpx rgba(0, 0, 0, 0.12),
    inset 0 0 14rpx rgba(255, 255, 255, 0.3);
  
  color: white;
  font-weight: 700;
  font-size: 30rpx;
  text-align: center;
  transition: all 0.2s ease;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 2rpx;
}

.glass-btn::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.15) 0%, 
    rgba(255, 255, 255, 0.05) 100%);
  pointer-events: none;
  border-radius: 20rpx;
}

.glass-btn:active {
  transform: scale(0.97);
  box-shadow: 
    0 2rpx 8rpx rgba(0, 0, 0, 0.15),
    inset 0 0 18rpx rgba(255, 255, 255, 0.35);
}

.glass-btn::after {
  border: none;
}

/* 渐变主按钮 */
.glass-btn-primary {
  position: relative;
  padding: 28rpx 48rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, 
    rgba(99, 102, 241, 0.85) 0%, 
    rgba(168, 85, 247, 0.85) 100%);
  
  /* 8% 微磨 */
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  
  border: 1px solid rgba(255, 255, 255, 0.45);
  box-shadow: 
    0 8rpx 24rpx rgba(99, 102, 241, 0.45),
    inset 0 0 16rpx rgba(255, 255, 255, 0.25);
  
  color: white;
  font-weight: 800;
  font-size: 34rpx;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 3rpx;
}

.glass-btn-primary:active {
  transform: scale(0.97);
}

.glass-btn-primary::after {
  border: none;
}

/* 苹果液态玻璃输入框 */
.glass-input {
  position: relative;
  padding: 30rpx 28rpx;
  min-height: 96rpx;
  border-radius: 18rpx;
  background: transparent;
  
  /* 8% 微磨 */
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  
  border: 1px solid rgba(255, 255, 255, 0.45);
  box-shadow: 
    inset 0 0 14rpx rgba(255, 255, 255, 0.25),
    0 3rpx 10rpx rgba(0, 0, 0, 0.1);
  
  font-size: 30rpx;
  color: white;
  font-weight: 600;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
}

.glass-input::placeholder {
  color: rgba(255, 255, 255, 0.75);
  font-weight: 500;
}

/* 苹果液态玻璃标签 */
.glass-tag {
  position: relative;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  background: transparent;
  
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  
  border: 1px solid rgba(255, 255, 255, 0.45);
  box-shadow: 
    0 2rpx 8rpx rgba(0, 0, 0, 0.1),
    inset 0 0 8rpx rgba(255, 255, 255, 0.2);
  
  font-size: 24rpx;
  color: white;
  font-weight: 600;
  display: inline-block;
  transition: all 0.2s ease;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

.glass-tag:active {
  transform: scale(0.95);
}

.glass-tag.active {
  background: rgba(99, 102, 241, 0.55);
  border-color: rgba(255, 255, 255, 0.5);
  box-shadow: 
    0 4rpx 12rpx rgba(99, 102, 241, 0.35),
    inset 0 0 10rpx rgba(255, 255, 255, 0.2);
}

/* 文本样式 - 高对比度 */
.text-primary {
  color: white;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.4);
}

.text-secondary {
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.3);
}

.text-muted {
  color: rgba(255, 255, 255, 0.75);
  font-weight: 500;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.25);
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 28rpx;
  font-weight: 600;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.3);
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.3));
}

.empty-text {
  font-size: 34rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
}

.empty-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.3);
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.3s ease;
}

/* iPad 横屏适配 */
@media (min-width: 768px) and (orientation: landscape) {
  .container {
    max-width: 1000rpx;
    margin: 0 auto;
    padding: 40rpx;
  }
}
