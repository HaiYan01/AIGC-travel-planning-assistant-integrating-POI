/* pages/index/index.wxss - 苹果液态玻璃 8%微磨砂 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.container {
  position: relative;
  z-index: 1;
  padding: 30rpx;
  min-height: 100vh;
}

/* 苹果液态玻璃卡片 */
.glass-card {
  position: relative;
  padding: 32rpx;
  border-radius: 28rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.glass-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.18) 0%, 
    rgba(255, 255, 255, 0.08) 50%,
    rgba(255, 255, 255, 0.12) 100%);
  pointer-events: none;
  mix-blend-mode: screen;
  border-radius: 28rpx;
}

/* Hero 区域 */
.hero {
  text-align: center;
  padding: 60rpx 0;
  margin-bottom: 30rpx;
}

.hero-icon {
  position: relative;
  width: 130rpx;
  height: 130rpx;
  border-radius: 32rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.2),
    inset 0 0 24rpx rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  overflow: hidden;
}

.hero-icon::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.2) 0%, 
    rgba(255, 255, 255, 0.08) 100%);
  pointer-events: none;
  border-radius: 32rpx;
}

.icon-compass {
  font-size: 64rpx;
  filter: drop-shadow(0 3rpx 6rpx rgba(0, 0, 0, 0.3));
}

.hero-title {
  font-size: 52rpx;
  font-weight: 900;
  color: white;
  margin-bottom: 16rpx;
  text-shadow: 
    0 3rpx 8rpx rgba(0, 0, 0, 0.5),
    0 1rpx 3rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 4rpx;
}

.hero-desc {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 600;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
  letter-spacing: 2rpx;
}

/* 快捷入口 */
.quick-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.action-card {
  flex: 1;
  position: relative;
  padding: 36rpx 24rpx;
  text-align: center;
  border-radius: 28rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  overflow: hidden;
  transition: all 0.2s ease;
}

.action-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.18) 0%, 
    rgba(255, 255, 255, 0.08) 100%);
  pointer-events: none;
  border-radius: 28rpx;
}

.action-card:active {
  transform: scale(0.96);
  box-shadow: 
    0 4rpx 16rpx rgba(0, 0, 0, 0.2),
    inset 0 0 26rpx rgba(255, 255, 255, 0.45);
}

.action-icon {
  font-size: 52rpx;
  margin-bottom: 16rpx;
  filter: drop-shadow(0 3rpx 6rpx rgba(0, 0, 0, 0.25));
}

.action-title {
  font-size: 34rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 8rpx;
  text-shadow: 
    0 2rpx 6rpx rgba(0, 0, 0, 0.45),
    0 1rpx 2rpx rgba(0, 0, 0, 0.25);
  letter-spacing: 2rpx;
}

.action-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.35);
}

/* 工具入口 */
.tools-section {
  position: relative;
  display: flex;
  justify-content: space-around;
  padding: 32rpx 20rpx;
  margin-bottom: 30rpx;
  border-radius: 28rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  overflow: hidden;
}

.tools-section::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.15) 0%, 
    rgba(255, 255, 255, 0.06) 100%);
  pointer-events: none;
  border-radius: 28rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx;
  transition: all 0.2s ease;
  z-index: 1;
}

.tool-item:active {
  transform: scale(0.88);
}

.tool-icon {
  font-size: 50rpx;
  margin-bottom: 12rpx;
  filter: drop-shadow(0 3rpx 5rpx rgba(0, 0, 0, 0.25));
}

.tool-name {
  font-size: 24rpx;
  color: white;
  font-weight: 700;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.35);
}

/* 分区 */
.section {
  position: relative;
  padding: 32rpx;
  margin-bottom: 30rpx;
  border-radius: 28rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  overflow: hidden;
}

.section::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.15) 0%, 
    rgba(255, 255, 255, 0.06) 100%);
  pointer-events: none;
  border-radius: 28rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 24rpx;
  text-shadow: 
    0 2rpx 6rpx rgba(0, 0, 0, 0.45),
    0 1rpx 2rpx rgba(0, 0, 0, 0.25);
  letter-spacing: 2rpx;
  z-index: 1;
  position: relative;
}

/* 热门城市 */
.hot-cities {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.city-tag {
  position: relative;
  padding: 14rpx 30rpx;
  border-radius: 22rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.5);
  box-shadow: 
    0 3rpx 10rpx rgba(0, 0, 0, 0.12),
    inset 0 0 10rpx rgba(255, 255, 255, 0.25);
  font-size: 26rpx;
  color: white;
  font-weight: 700;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.35);
  transition: all 0.2s ease;
}

.city-tag:active {
  transform: scale(0.94);
  box-shadow: 
    0 2rpx 6rpx rgba(0, 0, 0, 0.15),
    inset 0 0 14rpx rgba(255, 255, 255, 0.3);
}

/* 功能特色 */
.features {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  position: relative;
  z-index: 1;
}

.feature-row {
  display: flex;
  gap: 18rpx;
}

.feature-item {
  flex: 1;
  position: relative;
  padding: 28rpx 20rpx;
  text-align: center;
  border-radius: 20rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.45);
  box-shadow: 
    0 4rpx 12rpx rgba(0, 0, 0, 0.1),
    inset 0 0 12rpx rgba(255, 255, 255, 0.2);
  overflow: hidden;
}

.feature-item::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.12) 0%, 
    transparent 100%);
  pointer-events: none;
  border-radius: 20rpx;
}

.feature-icon {
  font-size: 44rpx;
  margin-bottom: 14rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.25));
  position: relative;
  z-index: 1;
}

.feature-name {
  font-size: 26rpx;
  color: white;
  font-weight: 700;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.35);
  position: relative;
  z-index: 1;
}

/* iPad 横屏适配 */
@media (min-width: 768px) and (orientation: landscape) {
  .container {
    max-width: 1000rpx;
    margin: 0 auto;
    padding: 40rpx;
  }
  
  .quick-actions {
    gap: 30rpx;
  }
  
  .action-card {
    padding: 44rpx 30rpx;
  }
  
  .hero-title {
    font-size: 56rpx;
  }
}
