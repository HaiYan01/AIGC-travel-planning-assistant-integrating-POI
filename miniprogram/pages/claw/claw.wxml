<!--pages/claw/claw.wxml-->
<image class="bg-image" src="/images/bg.jpg" mode="aspectFill"></image>
<view class="container">
  <!-- 头部 -->
  <view class="header">
    <view class="header-title">
      <text class="header-icon">🤖</text>
      <text class="header-text">ClawBot</text>
      <text class="glass-tag header-tag">百度AI</text>
    </view>
    <view class="header-action" bindtap="clearChat" wx:if="{{messages.length > 0}}">
      <text class="clear-text">清空</text>
    </view>
  </view>

  <!-- 功能模式 -->
  <view class="mode-bar">
    <view 
      class="glass-card mode-btn {{mode === 'chat' ? 'active' : ''}}" 
      bindtap="setMode" 
      data-mode="chat"
    >💬 智能对话</view>
    <view 
      class="glass-card mode-btn {{mode === 'analyze' ? 'active' : ''}}" 
      bindtap="setMode" 
      data-mode="analyze"
    >🔍 深度分析</view>
  </view>

  <!-- 消息区域 -->
  <scroll-view 
    class="messages" 
    scroll-y 
    scroll-into-view="{{scrollIntoView}}"
  >
    <!-- 欢迎界面 -->
    <view class="welcome" wx:if="{{messages.length === 0}}">
      <view class="welcome-icon">🤖</view>
      <view class="welcome-title">你好！我是 ClawBot</view>
      <view class="welcome-desc">基于百度AI的智能旅行助手</view>
      <view class="welcome-tags">
        <text class="glass-tag tag">百度AI</text>
        <text class="glass-tag tag">联网搜索</text>
        <text class="glass-tag tag">深度分析</text>
      </view>
      
      <!-- 快捷功能 -->
      <view class="quick-actions">
        <view class="quick-title">试试这些问题：</view>
        <view class="glass-card quick-btn" bindtap="quickAction" data-text="请分析我的旅行计划并提供优化建议">
          <text class="quick-icon">💡</text>
          <text>行程建议</text>
        </view>
        <view class="glass-card quick-btn" bindtap="quickAction" data-text="请帮我总结以下游记的要点：">
          <text class="quick-icon">📝</text>
          <text>攻略总结</text>
        </view>
        <view class="glass-card quick-btn" bindtap="quickAction" data-text="我想去">
          <text class="quick-icon">⚡</text>
          <text>智能规划</text>
        </view>
      </view>
    </view>

    <!-- 消息列表 -->
    <block wx:for="{{messages}}" wx:key="index" wx:for-index="idx">
      <view id="msg-{{idx}}" class="message {{item.role === 'user' ? 'user' : 'assistant'}}">
        <view class="message-avatar">
          <text wx:if="{{item.role === 'user'}}">👤</text>
          <text wx:else>🤖</text>
        </view>
        <view class="glass-card message-content">
          <text>{{item.content}}</text>
        </view>
      </view>
    </block>

    <!-- 加载中 -->
    <view class="message assistant" wx:if="{{loading}}">
      <view class="message-avatar">🤖</view>
      <view class="glass-card message-content loading">
        <view class="loading-dots">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
        <text>思考中...</text>
      </view>
    </view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="glass-card input-area">
    <input 
      class="glass-input input" 
      placeholder="输入你的问题，ClawBot来帮你..." 
      value="{{inputText}}"
      bindinput="onInput"
      bindconfirm="sendMessage"
      confirm-type="send"
    />
    <view 
      class="send-btn {{inputText.trim() ? 'active' : ''}}" 
      bindtap="sendMessage"
    >
      发送
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="bottom-tip">
    当前模式：{{mode === 'chat' ? '智能对话' : '深度分析'}}
  </view>
</view>
