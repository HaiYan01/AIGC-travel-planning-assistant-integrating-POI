/* pages/weather/weather.wxss */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.container {
  position: relative;
  z-index: 1;
  padding: 30rpx;
  min-height: 100vh;
}

.glass-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.35);
  box-shadow: 
    0 8rpx 30rpx rgba(0, 0, 0, 0.12),
    inset 0 3rpx 12rpx rgba(255, 255, 255, 0.25);
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.glass-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, 
    rgba(255, 255, 255, 0.12) 0%, 
    transparent 100%);
  pointer-events: none;
  border-radius: 28rpx 28rpx 0 0;
}

.search-card {
  padding: 24rpx;
}

.search-box {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  min-height: 88rpx;
  font-size: 30rpx;
  color: white;
  font-weight: 600;
  box-shadow: 
    inset 0 0 14rpx rgba(255, 255, 255, 0.25),
    0 3rpx 10rpx rgba(0, 0, 0, 0.1);
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.3);
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.75);
  font-weight: 500;
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.45);
}

.search-btn {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.8) 0%, rgba(168, 85, 247, 0.8) 100%);
  color: white;
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: 1px solid rgba(255, 255, 255, 0.25);
  box-shadow: inset 0 2rpx 8rpx rgba(255, 255, 255, 0.15);
}

.hot-cities {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.hot-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.city-tag {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: white;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.loading {
  text-align: center;
  padding: 80rpx 0;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.weather-card {
  padding: 36rpx;
}

.weather-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.city-name {
  font-size: 36rpx;
  font-weight: 600;
  color: white;
}

.update-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.weather-main {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.weather-icon {
  font-size: 100rpx;
  margin-right: 32rpx;
}

.weather-info {
  flex: 1;
}

.temperature {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 8rpx;
  color: white;
}

.weather-desc {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.85);
}

.weather-details {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  margin-bottom: 24rpx;
}

.detail-item {
  text-align: center;
}

.detail-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.detail-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 4rpx;
  font-weight: 500;
}

.detail-value {
  font-size: 26rpx;
  color: white;
  font-weight: 500;
}

.advice-card {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(255, 255, 255, 0.1);
}

.advice-icon {
  font-size: 36rpx;
}

.advice-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
}

.forecast-card {
  padding: 32rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.title-icon {
  margin-right: 12rpx;
}

.forecast-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.forecast-item {
  display: flex;
  align-items: center;
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(255, 255, 255, 0.08);
}

.forecast-date {
  width: 120rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.forecast-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.forecast-weather {
  flex: 1;
  font-size: 26rpx;
  color: white;
}

.forecast-temp {
  font-size: 26rpx;
  color: white;
  font-weight: 500;
  margin-right: 16rpx;
}

.forecast-wind {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.welcome {
  text-align: center;
  padding: 120rpx 40rpx;
}

.welcome-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 16rpx;
}

.welcome-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}
