<!--pages/community/community.wxml-->
<image class="bg-image" src="/images/bg.jpg" mode="aspectFill"></image>
<view class="container">
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view 
      class="glass-tag filter-item {{sort === 'newest' ? 'active' : ''}}" 
      data-sort="newest" 
      bindtap="changeSort"
    >
      最新
    </view>
    <view 
      class="glass-tag filter-item {{sort === 'popular' ? 'active' : ''}}" 
      data-sort="popular" 
      bindtap="changeSort"
    >
      最热
    </view>
  </view>

  <!-- 行程列表 -->
  <view class="plan-list">
    <view 
      class="glass-card plan-card" 
      wx:for="{{plans}}" 
      wx:key="id"
      bindtap="goToPlan"
      data-id="{{item.id}}"
    >
      <view class="plan-header">
        <view class="author-info">
          <view class="author-avatar">{{item.avatarInitial}}</view>
          <view class="author-name">{{item.authorName}}</view>
        </view>
        <view class="plan-date">{{item.createdAt}}</view>
      </view>
      <view class="plan-title">{{item.title}}</view>
      <view class="plan-tags">
        <view class="glass-tag tag">{{item.destination}}</view>
        <view class="glass-tag tag">{{item.days}}天</view>
      </view>
      <view class="plan-stats">
        <view class="stat">
          <text class="stat-icon">👁</text>
          <text>{{item.viewCount || 0}}</text>
        </view>
        <view class="stat">
          <text class="stat-icon">❤</text>
          <text>{{item._count ? item._count.likes : 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <view class="text-muted" wx:if="{{!hasMore && plans.length > 0}}" style="text-align:center;padding:40rpx;">没有更多了</view>
  <view class="empty" wx:if="{{!loading && plans.length === 0}}">
    <view class="empty-icon">📭</view>
    <view class="empty-text">暂无公开行程</view>
  </view>
</view>
