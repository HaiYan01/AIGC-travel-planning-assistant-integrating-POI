/* pages/chat/chat.wxss */
/* 苹果液态玻璃 8%微磨砂风格 */

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

.chat-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20rpx;
}

.message-list {
  flex: 1;
  height: 0;
  padding-bottom: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.empty-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  margin-bottom: 48rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.quick-questions {
  width: 100%;
}

.quick-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 700;
  margin-bottom: 20rpx;
  text-align: left;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.quick-item {
  position: relative;
  padding: 24rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: white;
  text-align: left;
  border-radius: 20rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  font-weight: 700;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
  overflow: hidden;
}

.quick-item::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.18) 0%, 
    rgba(255, 255, 255, 0.08) 50%,
    rgba(255, 255, 255, 0.12) 100%);
  pointer-events: none;
  mix-blend-mode: screen;
  border-radius: 20rpx;
}

.quick-item:active {
  background: rgba(255, 255, 255, 0.1);
}

.message-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.message-item.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
  border: 1px solid rgba(255, 255, 255, 0.68);
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.avatar.user {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.8), rgba(168, 85, 247, 0.8));
  color: white;
  margin-left: 16rpx;
}

.avatar.assistant {
  background: transparent;
  color: white;
  margin-right: 16rpx;
}

.message-content {
  max-width: 70%;
}

.message-text {
  position: relative;
  padding: 24rpx;
  font-size: 28rpx;
  color: white;
  line-height: 1.6;
  margin-bottom: 0;
  border-radius: 20rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  font-weight: 600;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
  overflow: hidden;
}

.message-text::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.18) 0%, 
    rgba(255, 255, 255, 0.08) 50%,
    rgba(255, 255, 255, 0.12) 100%);
  pointer-events: none;
  mix-blend-mode: screen;
  border-radius: 20rpx;
}

.message-item.user .message-text {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.6), rgba(168, 85, 247, 0.6));
}

.loading-dots {
  display: flex;
  gap: 8rpx;
  padding: 24rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  animation: bounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

.input-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  margin: 0 0 20rpx 0;
  position: relative;
  border-radius: 20rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  overflow: hidden;
}

.input-area::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.18) 0%, 
    rgba(255, 255, 255, 0.08) 50%,
    rgba(255, 255, 255, 0.12) 100%);
  pointer-events: none;
  mix-blend-mode: screen;
  border-radius: 20rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  padding: 12rpx;
  font-weight: 600;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.input-box {
  flex: 1;
  padding: 24rpx 20rpx;
  min-height: 80rpx;
  font-size: 30rpx;
  color: white;
  font-weight: 600;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.75);
  font-weight: 500;
}

.send-btn {
  position: relative;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 4rpx 16rpx rgba(0, 0, 0, 0.12),
    inset 0 0 14rpx rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.85);
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.3);
}

.send-btn::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.15) 0%, 
    rgba(255, 255, 255, 0.05) 100%);
  pointer-events: none;
  border-radius: 16rpx;
}

.send-btn.active {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.7), rgba(168, 85, 247, 0.7));
  border-color: rgba(255, 255, 255, 0.35);
  color: white;
}
