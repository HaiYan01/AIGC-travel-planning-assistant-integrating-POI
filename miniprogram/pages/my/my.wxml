<!--pages/my/my.wxml-->
<image class="bg-image" src="/images/bg.jpg" mode="aspectFill"></image>
<view class="container">
  <!-- 未登录状态 -->
  <view class="glass-card card" wx:if="{{!userInfo}}">
    <view class="login-prompt">
      <view class="avatar-placeholder">👤</view>
      <view class="login-title">请先登录</view>
      <view class="login-desc">登录后可保存和管理行程</view>
      <button class="glass-btn-primary login-btn" bindtap="goToLogin">立即登录</button>
    </view>
  </view>

  <!-- 已登录状态 -->
  <block wx:if="{{userInfo}}">
    <!-- 用户信息 -->
    <view class="glass-card card user-card">
      <view class="user-info">
        <view class="avatar">{{userInfo.username[0]}}</view>
        <view class="user-detail">
          <view class="username">{{userInfo.nickname || userInfo.username}}</view>
          <view class="email">{{userInfo.email}}</view>
        </view>
      </view>
      <view class="stats">
        <view class="stat-item">
          <view class="stat-value">{{plans.length}}</view>
          <view class="stat-label">行程数</view>
        </view>
      </view>
    </view>

    <!-- 我的行程 -->
    <view class="glass-card card">
      <view class="card-header">
        <view class="card-title">我的行程</view>
        <view class="glass-tag add-btn" bindtap="goToGenerate">+ 新建</view>
      </view>
      
      <view class="plan-list" wx:if="{{plans.length > 0}}">
        <view 
          class="glass-card plan-item" 
          wx:for="{{plans}}" 
          wx:key="id"
        >
          <view class="plan-content" bindtap="goToPlan" data-id="{{item.id}}">
            <view class="plan-title">{{item.title}}</view>
            <view class="plan-info">
              <text>{{item.destination}}</text>
              <text>{{item.days}}天</text>
              <text>¥{{item.budget}}</text>
            </view>
            <view class="plan-stats">
              <text>👁 {{item.viewCount || 0}}</text>
              <text>❤ {{item._count ? item._count.likes : 0}}</text>
              <text>{{item.isPublic ? '🌍 公开' : '🔒 私密'}}</text>
            </view>
          </view>
          <view class="plan-actions">
            <view class="delete-btn" data-id="{{item.id}}" catchtap="deletePlan">删除</view>
          </view>
        </view>
      </view>

      <view class="empty" wx:if="{{plans.length === 0}}">
        <view class="empty-icon">📋</view>
        <view class="empty-text">还没有行程</view>
        <button class="glass-btn empty-btn" bindtap="goToGenerate">创建第一个行程</button>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="glass-card card logout-card">
      <view class="logout-btn" bindtap="logout">退出登录</view>
    </view>
  </block>
</view>
