  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.18) 0%, 
    rgba(255, 255, 255, 0.08) 50%,
    rgba(255, 255, 255, 0.12) 100%);
  pointer-events: none;
  mix-blend-mode: screen;
  border-radius: 16rpx;
}

.meal-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  margin-bottom: 8rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.meal-name {
  font-size: 24rpx;
  color: white;
  font-weight: 700;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.meal-rec {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
  font-weight: 600;
  margin-top: 4rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.tips-list {
  padding-left: 8rpx;
}

.tip-item {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  line-height: 1.8;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.ticket-info {
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.ticket-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.ticket-name {
  font-size: 26rpx;
  font-weight: 700;
  color: white;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.ticket-level {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: rgba(251, 191, 36, 0.3);
  border-color: rgba(251, 191, 36, 0.4);
  font-weight: 700;
  color: white;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.ticket-details {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  margin-bottom: 12rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.ticket-btns {
  display: flex;
  gap: 12rpx;
}

.ticket-btn {
  position: relative;
  flex: 1;
  padding: 12rpx;
  font-size: 24rpx;
  color: white;
  margin-bottom: 0;
  border-radius: 16rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 4rpx 16rpx rgba(0, 0, 0, 0.12),
    inset 0 0 14rpx rgba(255, 255, 255, 0.3);
  font-weight: 700;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
}

.ticket-btn::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.15) 0%, 
    rgba(255, 255, 255, 0.05) 100%);
  pointer-events: none;
  border-radius: 16rpx;
}

.ticket-btn.secondary {
  background: transparent;
  color: rgba(255, 255, 255, 0.85);
}

.weather-card {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.4), rgba(118, 75, 162, 0.4));
}

.weather-title {
  font-size: 28rpx;
  font-weight: 800;
  color: white;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.weather-main {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.weather-temp {
  font-size: 52rpx;
  font-weight: 900;
  margin-right: 16rpx;
  color: white;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.weather-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 700;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.weather-advice {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  padding-top: 12rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.transport-btns {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.transport-btn {
  position: relative;
  flex: 1;
  padding: 20rpx;
  text-align: center;
  margin-bottom: 0;
  border-radius: 20rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  overflow: hidden;
}

.transport-btn::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.18) 0%, 
