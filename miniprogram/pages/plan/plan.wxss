  border-color: rgba(255, 255, 255, 0.35);
  color: white;
}

.privacy-notice {
  text-align: center;
  padding: 40rpx 0;
}

.privacy-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.privacy-text {
  font-size: 32rpx;
