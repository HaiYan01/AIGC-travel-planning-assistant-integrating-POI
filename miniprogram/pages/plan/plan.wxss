  pointer-events: none;
  mix-blend-mode: screen;
  border-radius: 20rpx;
}

.transport-icon {
  font-size: 36rpx;
  display: block;
  margin-bottom: 8rpx;
}

.transport-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.comment-card {
  position: relative;
  padding: 32rpx;
  border-radius: 28rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.comment-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.18) 0%, 
    rgba(255, 255, 255, 0.08) 50%,
    rgba(255, 255, 255, 0.12) 100%);
  pointer-events: none;
  mix-blend-mode: screen;
  border-radius: 28rpx;
}

.comment-list {
  margin-bottom: 24rpx;
}

.comment-item {
  display: flex;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.comment-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(99, 102, 241, 0.4);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
  border: 1px solid rgba(255, 255, 255, 0.68);
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.comment-author {
  font-size: 26rpx;
  font-weight: 700;
  color: white;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.comment-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.comment-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  line-height: 1.6;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.empty-comments {
  text-align: center;
  padding: 32rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 700;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.comment-input-area {
  display: flex;
  gap: 16rpx;
  padding-top: 24rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
}

.comment-input {
  flex: 1;
  padding: 24rpx 20rpx;
  min-height: 80rpx;
  font-size: 28rpx;
}

.comment-input-placeholder {
  color: rgba(255, 255, 255, 0.75);
  font-weight: 500;
}

.comment-submit {
  position: relative;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 4rpx 16rpx rgba(0, 0, 0, 0.12),
    inset 0 0 14rpx rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.85);
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
}

.comment-submit::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.15) 0%, 
    rgba(255, 255, 255, 0.05) 100%);
  pointer-events: none;
  border-radius: 16rpx;
}

.comment-submit.active {
