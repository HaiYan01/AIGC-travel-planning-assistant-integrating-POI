/* pages/plan/plan.wxss */
/* 苹果液态玻璃 8%微磨砂风格 */

.container {
  padding: 20rpx;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.header-card {
  position: relative;
  padding: 36rpx;
  border-radius: 28rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.header-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.18) 0%, 
    rgba(255, 255, 255, 0.08) 50%,
    rgba(255, 255, 255, 0.12) 100%);
  pointer-events: none;
  mix-blend-mode: screen;
  border-radius: 28rpx;
}

.plan-title {
  font-size: 40rpx;
  font-weight: 900;
  color: white;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.plan-info {
  display: flex;
  gap: 32rpx;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: white;
  font-weight: 700;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.info-icon {
  font-size: 24rpx;
}

.plan-prefs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.pref-tag {
  position: relative;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.45);
  box-shadow: 
    0 2rpx 8rpx rgba(0, 0, 0, 0.1),
    inset 0 0 8rpx rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
  color: white;
  font-weight: 700;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

.action-bar {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
  gap: 12rpx;
}

.action-btn {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: white;
  padding: 16rpx 12rpx;
  margin-bottom: 0;
  border-radius: 20rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  font-weight: 700;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
  overflow: hidden;
}

.action-btn::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.18) 0%, 
    rgba(255, 255, 255, 0.08) 50%,
    rgba(255, 255, 255, 0.12) 100%);
  pointer-events: none;
  mix-blend-mode: screen;
  border-radius: 20rpx;
}

.action-icon {
  font-size: 28rpx;
}

.day-selector {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
  padding: 0 10rpx;
}

.day-tab {
  position: relative;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.45);
  box-shadow: 
    0 2rpx 8rpx rgba(0, 0, 0, 0.1),
    inset 0 0 8rpx rgba(255, 255, 255, 0.2);
  font-size: 26rpx;
  color: white;
  font-weight: 700;
  white-space: nowrap;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

.day-theme {
  font-size: 34rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.day-budget {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  margin-bottom: 24rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.activity-list {
  position: relative;
  padding-left: 24rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.2);
}

.activity-item {
  position: relative;
  margin-bottom: 32rpx;
  padding-left: 24rpx;
}

.activity-item::before {
  content: '';
  position: absolute;
  left: -32rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
}

.activity-time {
  font-size: 24rpx;
  color: white;
  font-weight: 700;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.activity-content {
  position: relative;
  padding: 20rpx;
  margin-bottom: 0;
  border-radius: 20rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  overflow: hidden;
}

.activity-content::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.18) 0%, 
    rgba(255, 255, 255, 0.08) 50%,
    rgba(255, 255, 255, 0.12) 100%);
  pointer-events: none;
  mix-blend-mode: screen;
  border-radius: 20rpx;
}

.activity-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.activity-type {
  position: relative;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.45);
  box-shadow: 
    0 2rpx 8rpx rgba(0, 0, 0, 0.1),
    inset 0 0 8rpx rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
  color: white;
  font-weight: 700;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

.activity-type.attraction {
  background: rgba(59, 130, 246, 0.3);
  border-color: rgba(59, 130, 246, 0.4);
}

.activity-type.food {
  background: rgba(249, 115, 22, 0.3);
  border-color: rgba(249, 115, 22, 0.4);
}

.activity-type.transport {
  background: rgba(34, 197, 94, 0.3);
  border-color: rgba(34, 197, 94, 0.4);
}

.activity-type.hotel {
  background: rgba(168, 85, 247, 0.3);
  border-color: rgba(168, 85, 247, 0.4);
}

.activity-cost {
  font-size: 24rpx;
  color: white;
  font-weight: 700;
  margin-left: auto;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.activity-name {
  font-size: 30rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.activity-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 8rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.activity-address {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  margin-bottom: 8rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.activity-tips {
  font-size: 24rpx;
  color: #fbbf24;
  font-weight: 700;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.nav-btn {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: white;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.meals {
