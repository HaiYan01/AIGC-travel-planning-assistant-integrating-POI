  color: white;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.summary-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  line-height: 1.6;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.insurance-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  margin-bottom: 20rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.insurance-list {
  margin-bottom: 20rpx;
}

.insurance-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
