  border-top: 1px solid rgba(255, 255, 255, 0.15);
}

.meals-title {
  font-size: 28rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.meal-list {
  display: flex;
  gap: 16rpx;
}

.meal-item {
  position: relative;
  flex: 1;
  padding: 16rpx;
  text-align: center;
  margin-bottom: 0;
  border-radius: 16rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
