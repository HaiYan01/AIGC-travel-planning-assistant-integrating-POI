/* pages/login/login.wxss */
/* 苹果液态玻璃 8%微磨砂风格 */

.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  position: relative;
  z-index: 1;
}

.card {
  position: relative;
  width: 100%;
  padding: 48rpx 36rpx;
  border-radius: 28rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  overflow: hidden;
}

.card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.18) 0%, 
    rgba(255, 255, 255, 0.08) 50%,
    rgba(255, 255, 255, 0.12) 100%);
  pointer-events: none;
  mix-blend-mode: screen;
  border-radius: 28rpx;
}

.logo {
  text-align: center;
  margin-bottom: 24rpx;
}

.logo-icon {
  font-size: 72rpx;
}

.title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 900;
  color: white;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.desc {
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  margin-bottom: 48rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.form-item {
  margin-bottom: 24rpx;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  margin-top: 32rpx;
}

.submit-btn.loading {
  opacity: 0.7;
}

.submit-btn::after {
  border: none;
}

.switch-mode {
  text-align: center;
  margin-top: 32rpx;
}

.switch-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.4);
}

.switch-link {
  font-size: 26rpx;
  color: white;
  font-weight: 700;
  margin-left: 8rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}
