/* pages/generate/generate.wxss - 苹果液态玻璃 8%微磨砂 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.container {
  position: relative;
  z-index: 1;
  padding: 30rpx;
  min-height: 100vh;
}

/* 苹果液态玻璃卡片 */
.glass-card {
  position: relative;
  padding: 40rpx;
  border-radius: 28rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.18),
    inset 0 0 22rpx rgba(255, 255, 255, 0.4);
  overflow: hidden;
}

.glass-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.18) 0%, 
    rgba(255, 255, 255, 0.08) 50%,
    rgba(255, 255, 255, 0.12) 100%);
  pointer-events: none;
  mix-blend-mode: screen;
  border-radius: 28rpx;
}

.card-title {
  font-size: 40rpx;
  font-weight: 900;
  color: white;
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  text-shadow: 
    0 3rpx 8rpx rgba(0, 0, 0, 0.5),
    0 1rpx 3rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 3rpx;
  position: relative;
  z-index: 1;
}

.title-icon {
  margin-right: 14rpx;
  font-size: 38rpx;
}

.card-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 40rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.35);
  position: relative;
  z-index: 1;
}

.form-item {
  margin-bottom: 36rpx;
  position: relative;
  z-index: 1;
}

.form-label {
  font-size: 30rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.4);
  letter-spacing: 1rpx;
}

.required {
  color: #fde68a;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.4);
}

.text-gray {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  font-weight: 500;
}

/* 苹果液态玻璃输入框 */
.glass-input {
  position: relative;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 18rpx;
  padding: 30rpx 28rpx;
  min-height: 96rpx;
  font-size: 30rpx;
  color: white;
  font-weight: 600;
  box-shadow: 
    inset 0 0 14rpx rgba(255, 255, 255, 0.25),
    0 3rpx 10rpx rgba(0, 0, 0, 0.1);
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.3);
  width: 100%;
  box-sizing: border-box;
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.75);
  font-weight: 500;
}

.picker-input {
  display: flex;
  align-items: center;
}

.picker-icon {
  margin-right: 14rpx;
  font-size: 32rpx;
}

.placeholder {
  color: rgba(255, 255, 255, 0.55);
}

.hot-cities {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 36rpx;
  position: relative;
  z-index: 1;
}

.hot-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
  font-weight: 600;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

/* 苹果液态玻璃标签 */
.glass-tag {
  position: relative;
  padding: 10rpx 24rpx;
  border-radius: 18rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.45);
  box-shadow: 
    0 3rpx 10rpx rgba(0, 0, 0, 0.1),
    inset 0 0 8rpx rgba(255, 255, 255, 0.2);
  font-size: 26rpx;
  color: white;
  font-weight: 700;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.35);
  transition: all 0.2s ease;
}

.glass-tag:active {
  transform: scale(0.94);
  box-shadow: 
    0 2rpx 6rpx rgba(0, 0, 0, 0.12),
    inset 0 0 12rpx rgba(255, 255, 255, 0.28);
}

.glass-tag.active {
  background: rgba(99, 102, 241, 0.55);
  border-color: rgba(255, 255, 255, 0.55);
  box-shadow: 
    0 4rpx 14rpx rgba(99, 102, 241, 0.4),
    inset 0 0 10rpx rgba(255, 255, 255, 0.25);
}

.city-tag {
  padding: 10rpx 24rpx;
  border-radius: 18rpx;
}

/* 天气卡片 */
.weather-card {
  margin-bottom: 36rpx;
  padding: 28rpx;
  position: relative;
  z-index: 1;
}

.weather-main {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.weather-temp {
  font-size: 56rpx;
  font-weight: 900;
  margin-right: 18rpx;
  color: white;
  text-shadow: 
    0 3rpx 8rpx rgba(0, 0, 0, 0.5),
    0 1rpx 3rpx rgba(0, 0, 0, 0.3);
}

.weather-desc {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.35);
}

.weather-advice {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  padding-top: 14rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.3);
}

.days-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.day-item {
  padding: 18rpx 34rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
}

.day-item.active {
  background: rgba(99, 102, 241, 0.55);
  border-color: rgba(255, 255, 255, 0.55);
}

.preferences {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.pref-tag {
  padding: 14rpx 30rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
}

.pref-tag.active {
  background: rgba(99, 102, 241, 0.5);
  border-color: rgba(255, 255, 255, 0.5);
}

.form-textarea {
  height: 180rpx;
}

/* 隐私设置选项 */
.privacy-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.privacy-option {
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 18rpx;
  background: transparent;
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  border: 1px solid rgba(255, 255, 255, 0.35);
  box-shadow: 
    0 4rpx 12rpx rgba(0, 0, 0, 0.1),
    inset 0 0 10rpx rgba(255, 255, 255, 0.2);
  overflow: hidden;
  transition: all 0.2s ease;
}

.privacy-option::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.12) 0%, 
    transparent 100%);
  pointer-events: none;
  border-radius: 18rpx;
}

.privacy-option:active {
  transform: scale(0.98);
}

.privacy-option.active {
  border-color: rgba(99, 102, 241, 0.6);
  background: rgba(99, 102, 241, 0.2);
  box-shadow: 
    0 4rpx 16rpx rgba(99, 102, 241, 0.3),
    inset 0 0 12rpx rgba(99, 102, 241, 0.15);
}

.privacy-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  position: relative;
  z-index: 1;
}

.privacy-info {
  flex: 1;
  position: relative;
  z-index: 1;
}

.privacy-title {
  font-size: 28rpx;
  font-weight: 700;
  color: white;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.35);
  margin-bottom: 4rpx;
}

.privacy-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  font-weight: 500;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.25);
}

.privacy-check {
  font-size: 28rpx;
  color: #6366f1;
  font-weight: 700;
  position: relative;
  z-index: 1;
}

/* 苹果液态玻璃主按钮 */
.glass-btn-primary {
  position: relative;
  width: 100%;
  background: linear-gradient(135deg, 
    rgba(99, 102, 241, 0.88) 0%, 
    rgba(168, 85, 247, 0.88) 100%);
  backdrop-filter: blur(0.8px);
  -webkit-backdrop-filter: blur(0.8px);
  color: white;
  border-radius: 22rpx;
  font-size: 36rpx;
  font-weight: 900;
  padding: 32rpx 0;
  margin-top: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.45);
  box-shadow: 
    0 10rpx 32rpx rgba(99, 102, 241, 0.5),
    inset 0 0 18rpx rgba(255, 255, 255, 0.3);
  text-shadow: 
    0 2rpx 6rpx rgba(0, 0, 0, 0.4),
    0 1rpx 2rpx rgba(0, 0, 0, 0.25);
  letter-spacing: 4rpx;
  position: relative;
  z-index: 1;
  overflow: hidden;
}

.glass-btn-primary::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.15) 0%, 
    rgba(255, 255, 255, 0.05) 100%);
  pointer-events: none;
  border-radius: 22rpx;
}

.glass-btn-primary.loading {
  opacity: 0.75;
}

.glass-btn-primary::after {
  border: none;
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.loading-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
}

/* iPad 横屏 */
@media (min-width: 768px) and (orientation: landscape) {
  .container {
    max-width: 900rpx;
    margin: 0 auto;
  }
}
