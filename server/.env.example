# ==================== 服务端环境变量 ====================
# 使用方法:复制本文件为 .env 并填入你自己的真实配置(请勿把 .env 提交到仓库)
# 所有需要申请/生成的密钥都先写成了 API_KEY 占位,具体申请方式见 项目文档/API配置指南.md

# 服务端口(本地开发建议 3001,与 web/vite.config.js 的代理一致;服务器/Docker 部署通常用 3000)
PORT=3001
NODE_ENV=development

# MySQL 连接串:mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL="mysql://root:API_KEY@localhost:3306/travel_planner"

# JWT 签名密钥(必须修改,可用命令生成:openssl rand -hex 32)
JWT_SECRET="API_KEY"
JWT_EXPIRES_IN="7d"

# ==================== AI 大模型(OpenAI 兼容接口)====================
# 任选一家服务商,填写对应的 Key、接口地址与模型名,例如:
#   智谱 GLM : https://open.bigmodel.cn/api/paas/v4   模型 glm-4-flash
#   小米 MiMo: https://api.xiaomi.com/v1             模型 MiMo
#   OpenAI   : https://api.openai.com/v1             模型 gpt-3.5-turbo
AI_API_KEY="API_KEY"
AI_API_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
AI_MODEL="glm-4-flash"

# ==================== 百度 AI(ClawBot 联网问答,可选)====================
BAIDU_APP_ID="API_KEY"
BAIDU_SECRET_KEY="API_KEY"
BAIDU_API_URL="https://agentapi.baidu.com/assistant/getAnswer"

# ==================== 高德开放平台(地图/POI/地理编码)====================
# AMAP_KEY:Web 服务 Key;AMAP_SECURITY_CODE:JS API 安全密钥
AMAP_KEY="API_KEY"
AMAP_SECURITY_CODE="API_KEY"
